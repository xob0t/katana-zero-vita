+static inline __attribute__((always_inline)) void record_scene_purge_position(void) {
+	uint32_t seq = gc_rotation_seq;
+	__sync_synchronize();
+	scene_purge_slot = frame_purge_idx;
+	scene_purge_elem = frame_elem_purge_idx;
+	scene_purge_rt = frame_rt_purge_idx;
+	__sync_synchronize();
+	if ((seq & 1) || seq != gc_rotation_seq) {
+		// The collector rotated the lists meanwhile: the indices may mix two slots, so keep all of the slot read
+		scene_purge_elem = 0;
+		scene_purge_rt = 0;
+	}
+	scene_purge_seq = seq & ~1;
