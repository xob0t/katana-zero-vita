+	// Let queued collections finish: the purge lists hold still from here on
+	sceKernelWaitSema(gc_mutex[1], FRAME_PURGE_FREQ, NULL);
+	sceKernelSignalSema(gc_mutex[1], FRAME_PURGE_FREQ);
+#endif
+	gc_kept_num = gc_kept_rt_num = 0;
+	if (!scene_open)
