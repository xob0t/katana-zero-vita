diff --git a/source/utils/mem_utils.c b/source/utils/mem_utils.c
index 4b791b7..1500b57 100644
--- a/source/utils/mem_utils.c
+++ b/source/utils/mem_utils.c
@@ -32,6 +32,40 @@ static void *mempool_addr[VGL_MEM_ALL] = {}; // Base addresses of heap memblocks
 static void *mempool_end[VGL_MEM_ALL] = {}; // Addresses of heap memblocks ends
 static size_t mempool_size[VGL_MEM_ALL] = {}; // Sizes (in bytes) of heap memblocks
 
+#ifndef HAVE_CUSTOM_HEAP
+// Optional split of the VRAM pool: allocations of at least VRAM_LARGE_MIN bytes (texture pages,
+// render surfaces) come from a separate region at the top of VRAM, so small long-lived allocations
+// can't fragment the space large pages need. Enabled by setting vgl_vram_small_size (bytes kept for
+// the small-allocation region) before initialization; 0 keeps a single VRAM heap.
+#define VRAM_LARGE_MIN (1024 * 1024)
+size_t vgl_vram_small_size = 0;
+static void *vram_large_mspace = NULL;
+static void *vram_large_base = NULL;
+
+static inline __attribute__((always_inline)) void *vram_mspace_for(void *ptr) {
+	return (vram_large_mspace && ptr >= vram_large_base) ? vram_large_mspace : mempool_mspace[VGL_MEM_VRAM];
+}
+
+static void *vram_memalign(size_t alignment, size_t size) {
+	void *first = size >= VRAM_LARGE_MIN ? vram_large_mspace : mempool_mspace[VGL_MEM_VRAM];
+	void *second = size >= VRAM_LARGE_MIN ? mempool_mspace[VGL_MEM_VRAM] : vram_large_mspace;
+	void *res = sceClibMspaceMemalign(first, alignment, size);
+	return res ? res : sceClibMspaceMemalign(second, alignment, size);
+}
+
+// Free bytes in the small and large VRAM regions (large is 0 when the split is off)
+void vgl_vram_split_free(size_t *small_free, size_t *large_free) {
+	SceClibMspaceStats stats;
+	sceClibMspaceMallocStats(mempool_mspace[VGL_MEM_VRAM], &stats);
+	*small_free = stats.capacity - stats.current_in_use;
+	*large_free = 0;
+	if (vram_large_mspace) {
+		sceClibMspaceMallocStats(vram_large_mspace, &stats);
+		*large_free = stats.capacity - stats.current_in_use;
+	}
+}
+#endif
+
