+// may still be in use by its commands: the render target of an fbo deleted right after drawing to it, a texture or
+// buffer replaced after a draw used it. Ending the scene early instead would split it, losing depth/stencil contents
+// (DEPTH_STENCIL_HACK keeps no memory for them) and the stencil-drawn scissor mask. So the entries released since the
+// open scene began are set aside for the collection and queued again afterwards; everything released before it began
+// (an earlier scene of the frame, finished by sceGxmFinish, or nothing drawn yet) is freed as before.
+static void *gc_kept[FRAME_PURGE_LIST_SIZE];
+static void *gc_kept_rt[FRAME_PURGE_RENDERTARGETS_LIST_SIZE];
+static int gc_kept_num, gc_kept_rt_num;
