+
+static void gc_keep_slot(int slot, int elem_from, int rt_from) {
+	for (int i = elem_from; i < FRAME_PURGE_LIST_SIZE && frame_purge_list[slot][i]; i++) {
+		gc_kept[gc_kept_num++] = frame_purge_list[slot][i];
+		frame_purge_list[slot][i] = NULL;
+	}
+	for (int i = rt_from; i < FRAME_PURGE_RENDERTARGETS_LIST_SIZE && frame_rt_purge_list[slot][i]; i++) {
+		gc_kept_rt[gc_kept_rt_num++] = frame_rt_purge_list[slot][i];
+		frame_rt_purge_list[slot][i] = NULL;
+	}
