+		gc_keep_slot(slot, scene_purge_elem, scene_purge_rt);
+		for (uint32_t i = 0; i < rotations; i++) {
+			slot = (slot + 1) % FRAME_PURGE_FREQ;
+			gc_keep_slot(slot, 0, 0);
+		}
+	}
+	return GL_TRUE;
